  BKASH
  SSLCOMMERZ
  CASH
  BANK_TRANSFER
  MANUAL
}

enum ReversalStatus {
  PENDING
  APPLIED
  REJECTED
}

enum CourierProviderCode {
  PATHAO
  STEADFAST
  CARRYBEE
  MANUAL
}

enum ShipmentType {
  SALE
  EXCHANGE_OUT
  EXCHANGE_RETURN
  REPLACEMENT
}

enum ShipmentStatus {
  DRAFT
  PENDING
  CREATED
  PICKED_UP
