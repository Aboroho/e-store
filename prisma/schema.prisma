  PROCESSING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentAttemptStatus {
  INITIATED
  REDIRECTED
  CALLBACK_RECEIVED
  VERIFIED
  FAILED
  EXPIRED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum RefundMethod {
