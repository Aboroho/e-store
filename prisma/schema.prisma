  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  RESERVED
  PREORDER_PENDING
  ALLOCATED
  DISPATCHED
  DELIVERED
  CANCELLED
  EXCHANGED
}

enum OrderAdjustmentType {
  DISCOUNT
  DELIVERY_FEE
  EXTRA_CHARGE
  PACKAGING
  COD_SURCHARGE
  ROUNDING
  RESELLER_COLLECTION
}

enum OrderStatusField {
