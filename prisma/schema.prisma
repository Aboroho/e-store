// ----------------------------------------------------------------------------
// Customers
// ----------------------------------------------------------------------------

/// A customer is identified business-wide by a normalised phone number, so the
/// same person is one record across all storefronts and sales channels.
model Customer {
  id                String         @id @default(uuid())
  businessId        String
  name              String
  phoneNormalized   String
  phone             String?
  email             String?
  emailNormalized   String?
  districtCode      String?
  addressLine       String?
  area              String?
  status            CustomerStatus @default(ACTIVE)
  passwordHash      String?
  hasAccount        Boolean        @default(false)
  phoneVerifiedAt   DateTime?
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  totalOrders       Int            @default(0)
  totalSpentPaisa   Int            @default(0)
  lifetimeValuePaisa Int           @default(0)
  firstOrderAt      DateTime?
  lastOrderAt       DateTime?
  isResellerCustomer Boolean       @default(false)
  referredByResellerId String?
  tags              String[]
  notes             String?
  createdByUserId   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  addresses      CustomerAddress[]
  customerNotes  CustomerNote[]
  orders         Order[]
  reviews        Review[]
  sessions       CustomerSession[]
  verifications  VerificationCode[]
  claimRequests  AccountClaimRequest[]
  consents       ConsentRecord[]
  reviewReports  ReviewReport[]
  exchanges      ExchangeRequest[]

  @@unique([businessId, phoneNormalized])
  @@index([businessId, emailNormalized])
  @@index([businessId, status])
  @@index([businessId, deletedAt])
}

model CustomerAddress {
  id               String   @id @default(uuid())
  customerId       String
  label            String?
  recipientName    String
  phoneNormalized  String
  phone            String?
  districtCode     String?
  addressLine      String
  area             String?
  postcode         String?
  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  district District? @relation(fields: [districtCode], references: [code], onDelete: SetNull)

  @@index([customerId])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  body       String
  isPinned   Boolean  @default(false)
  createdByUserId String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

/// Passwordless account claim request: the customer proves control of the
/// phone number by entering a one-time code delivered over SMS.
model AccountClaimRequest {
  id             String              @id @default(uuid())
  customerId     String
  phoneNormalized String
  purpose        VerificationPurpose @default(ACCOUNT_CLAIM)
  codeHash       String
  expiresAt      DateTime
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(5)
  completedAt    DateTime?
  cancelledAt    DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime            @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([expiresAt])
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

model Order {
  id                String            @id @default(uuid())
  businessId        String
  orderNumber       String
  storefrontId      String?
  channel           OrderChannel      @default(STOREFRONT)
  customerId        String?
  resellerId        String?
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(UNPAID)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String            @default("BDT")

  // Monetary snapshot (integer paisa, server calculated)
  itemsSubtotalPaisa   Int  @default(0)
  discountTotalPaisa   Int  @default(0)
  deliveryFeePaisa     Int  @default(0)
  extraChargePaisa     Int  @default(0)
  packagingCostPaisa   Int  @default(0)
  codSurchargePaisa    Int  @default(0)
  inventoryCostPaisa   Int  @default(0)
  grandTotalPaisa      Int  @default(0)
  paidPaisa            Int  @default(0)
  refundedPaisa        Int  @default(0)
  duePaisa             Int  @default(0)
  codCollectPaisa      Int  @default(0)

  // Customer snapshot (kept for historical integrity)
  customerName      String?
  customerPhone     String?
  customerPhoneNormalized String?
  customerEmail     String?
  shippingDistrictCode String?
  shippingAddressLine  String?
  shippingArea         String?
  deliveryNotes     String?

  // Reseller collection (amount reseller collects from their customer)
  resellerCollectionPaisa Int?
  resellerCostPaisa       Int  @default(0)
  resellerEarningPaisa    Int  @default(0)

  deliveryZoneId    String?
  expectedDeliveryAt DateTime?
  placedAt          DateTime          @default(now())
  confirmedAt       DateTime?
  processingAt      DateTime?
  readyToShipAt     DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  cancelledByUserId String?
  internalNote      String?
  customerNote      String?
  createdByUserId   String?
  updatedByUserId   String?
  idempotencyKey    String?           @unique
  sourceReference   String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storefront  Storefront?      @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reseller    Reseller?        @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  adjustments OrderAdjustment[]
  addresses   OrderAddress[]
  statusHistory OrderStatusHistory[]
  payments    Payment[]
  paymentAttempts PaymentAttempt[]
  refunds     Refund[]
  shipments   Shipment[]
  reservations StockReservation[]
  preorders   PreorderCommitment[]
  exchanges   ExchangeRequest[]
  codCollections CodCollection[]
  ledgerEntries ResellerLedgerEntry[]
  earnings    ResellerOrderEarning[]
  collectionChanges ResellerCollectionChange[]
  settlementEntries CourierSettlementEntry[]
  marketingEvents MarketingEvent[]
  reviews     Review[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status, placedAt])
  @@index([businessId, paymentStatus])
  @@index([customerId, placedAt])
  @@index([resellerId, placedAt])
  @@index([storefrontId, placedAt])
  @@index([channel, placedAt])
  @@index([placedAt])
  @@index([businessId, deletedAt])
}

model OrderItem {
  id               String          @id @default(uuid())
  orderId          String
  variantId        String?
  productId        String?
  sku              String
  productName      String
  variantName      String
  variantAttributes Json?
  quantity         Int
  unitPricePaisa   Int
  compareAtPricePaisa Int?
  unitCostPaisa    Int             @default(0)
  unitResellerPricePaisa Int?
  packagingCostPaisa Int           @default(0)
  discountPaisa    Int             @default(0)
  lineSubtotalPaisa Int
  lineTotalPaisa   Int
  taxPaisa         Int             @default(0)
  reservedQuantity Int             @default(0)
  preorderQuantity Int             @default(0)
  allocatedQuantity Int            @default(0)
  dispatchedQuantity Int           @default(0)
  cancelledQuantity Int            @default(0)
  returnedQuantity Int             @default(0)
  exchangedQuantity Int            @default(0)
  status           OrderItemStatus @default(PENDING)
  isPreorder       Boolean         @default(false)
  pricingSource    String?
  priceListId      String?
  note             String?
  position         Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        Variant?         @relation(fields: [variantId], references: [id], onDelete: SetNull)
  product        Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  exchangeItems  ExchangeItem[]
  reservation    StockReservation?
  preorder       PreorderCommitment?
  earnings       ResellerOrderEarning?
  review         Review?

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
}

model OrderAdjustment {
  id              String              @id @default(uuid())
  orderId         String
  type            OrderAdjustmentType
  label           String
  /// Signed amount. Discounts are negative, charges positive.
  amountPaisa     Int
  note            String?
  createdByUserId String?
  approvedByUserId String?
  createdAt       DateTime            @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
}

model OrderAddress {
  id           String           @id @default(uuid())
  orderId      String
  type         OrderAddressType @default(SHIPPING)
  recipientName String
  phone        String
  phoneNormalized String?
  districtCode String?
  districtName String?
  addressLine  String
  area         String?
  postcode     String?
  note         String?
  createdAt    DateTime         @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
}

model OrderStatusHistory {
  id         String           @id @default(uuid())
  orderId    String
  field      OrderStatusField @default(ORDER)
  fromStatus String?
  toStatus   String
  note       String?
  actorUserId String?
  actorType  ActorType        @default(USER)
  actorCustomerId String?
  createdAt  DateTime         @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([field, createdAt])
}

// ----------------------------------------------------------------------------
// Payments
// ----------------------------------------------------------------------------

model Payment {
  id            String              @id @default(uuid())
  businessId    String
  orderId       String
  method        PaymentMethod
  status        PaymentRecordStatus @default(PENDING)
  amountPaisa   Int
  paidPaisa     Int                 @default(0)
  refundedPaisa Int                 @default(0)
  currency      String              @default("BDT")
  integrationId String?
  providerName  String?
  providerReference String?
  providerPaymentId String?
  collectedByUserId String?
  receivedAt    DateTime?
  verifiedAt    DateTime?
  note          String?
  recordedByUserId String?
  idempotencyKey String?            @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts PaymentAttempt[]
  events   PaymentEvent[]
  refunds  Refund[]
  allocations PaymentAllocation[]
  settlements CourierSettlementEntry[]

  @@index([orderId, createdAt])
  @@index([businessId, status])
  @@index([providerReference])
  @@index([method, createdAt])
}

/// A single attempt to collect a payment through a provider (or manually).
/// Multiple attempts may exist for the same order/payment.
model PaymentAttempt {
  id                String               @id @default(uuid())
  paymentId         String?
  orderId           String
  businessId        String
  method            PaymentMethod
  status            PaymentAttemptStatus @default(INITIATED)
  amountPaisa       Int
  currency          String               @default("BDT")
  providerName      String?
  providerPaymentId String?
  providerTransactionId String?
  providerReference String?
  /// Our own unique reference sent to the provider (used for verification).
  clientReference   String               @unique
  redirectUrl       String?
  requestPayload    Json?
  responsePayload   Json?
  failureReason     String?
  verifiedAt        DateTime?
  expiresAt         DateTime?
  idempotencyKey    String?              @unique
  createdByUserId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events  PaymentEvent[]

  @@index([orderId, status])
  @@index([providerReference])
  @@index([providerPaymentId])
}

/// Raw provider callback / webhook record; unique provider event ids make
/// callback processing idempotent.
model PaymentEvent {
  id              String   @id @default(uuid())
  paymentId       String?
  paymentAttemptId String?
  orderId         String?
  businessId      String?
  providerName    String
  eventType       String
  providerEventId String?
  signatureValid  Boolean  @default(false)
  payload         Json
  headers         Json?
  status          WebhookEventStatus @default(RECEIVED)
  processingResult String?
  errorMessage    String?
  processedAt     DateTime?
  attempts        Int      @default(0)
  ipAddress       String?
  createdAt       DateTime @default(now())

  payment Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  attempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)

  @@unique([providerName, providerEventId])
  @@index([status, createdAt])
  @@index([providerName, createdAt])
}

/// Allocation of a payment to an order (supports partial payments and
/// payments spread across orders via exchanges).
model PaymentAllocation {
  id          String   @id @default(uuid())
  paymentId   String
  orderId     String?
  exchangeRequestId String?
  amountPaisa Int
  direction   String   @default("COLLECT")
  note        String?
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([orderId])
}

model Refund {
  id              String       @id @default(uuid())
  businessId      String
  orderId         String?
  paymentId       String?
  exchangeRequestId String?
  customerId      String?
  method          RefundMethod @default(MANUAL)
  status          RefundStatus @default(REQUESTED)
  amountPaisa     Int
  reason          String?
  note            String?
  providerName    String?
  providerReference String?
  providerRefundId String?
  requestedByUserId String?
  processedByUserId String?
  processedAt     DateTime?
  failureReason   String?
  idempotencyKey  String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment  Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  attempts RefundAttempt[]
  exchange ExchangeRequest? @relation(fields: [exchangeRequestId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([businessId, status, createdAt])
}

model RefundAttempt {
  id              String   @id @default(uuid())
  refundId        String
  status          RefundStatus @default(PROCESSING)
  providerName    String?
  providerReference String?
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  createdAt       DateTime @default(now())

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
}

/// Actual COD cash collected from the courier (or rider) for a shipment.
model CodCollection {
  id              String   @id @default(uuid())
  businessId      String
  orderId         String
  shipmentId      String?  @unique
  expectedPaisa   Int      @default(0)
  collectedPaisa  Int      @default(0)
  courierChargePaisa Int   @default(0)
  codChargePaisa  Int      @default(0)
  netPaisa        Int      @default(0)
  collectedAt     DateTime?
  recordedByUserId String?
  settlementId    String?
  status          String   @default("RECORDED")
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  settlement CourierSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([businessId, collectedAt])
  @@index([orderId])
}

/// Payment provider settlement / bank reconciliation records.
model PaymentReconciliation {
  id            String                      @id @default(uuid())
  businessId    String
  type          PaymentReconciliationType   @default(PAYMENT_PROVIDER)
  status        PaymentReconciliationStatus @default(PENDING)
  providerName  String?
  reference     String
  statementDate DateTime?
  grossPaisa    Int @default(0)
  feePaisa      Int @default(0)
  netPaisa      Int @default(0)
  matchedPaisa  Int @default(0)
  note          String?
  createdByUserId String?
  reconciledByUserId String?
  reconciledAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type, reference])
  @@index([businessId, status])
}

// ----------------------------------------------------------------------------
// Couriers and shipments
// ----------------------------------------------------------------------------

model CourierProvider {
  id            String               @id @default(uuid())
  businessId    String
  code          CourierProviderCode
  name          String
  isEnabled     Boolean              @default(false)
  testMode      Boolean              @default(true)
  integrationId String?
  pickupName    String?
  pickupPhone   String?
  pickupAddress String?
  pickupCity    String?
  pickupArea    String?
  defaultWeightGrams Int             @default(500)
  defaultDeliveryType String?
  codEnabled    Boolean              @default(true)
  returnFeePaisa Int                 @default(0)
  priority      Int                  @default(0)
  config        Json?
  lastSyncAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shipments  Shipment[]
  webhookEvents CourierWebhookEvent[]
  settlements CourierSettlement[]

  @@unique([businessId, code])
  @@index([businessId, isEnabled])
}

model Shipment {
  id                  String              @id @default(uuid())
  businessId          String
  orderId             String?
  exchangeRequestId   String?
  courierProviderId   String?
  providerCode        CourierProviderCode @default(MANUAL)
  type                ShipmentType        @default(SALE)
  status              ShipmentStatus      @default(DRAFT)
  internalCode        String
  providerConsignmentId String?
  trackingCode        String?
  merchantOrderId     String?
  // Recipient snapshot
  recipientName       String
  recipientPhone      String
  recipientPhoneNormalized String?
  recipientDistrictCode String?
  recipientAddress    String
  recipientArea       String?
  recipientNote       String?
  // Parcel description snapshot
  itemDescription     String?
  itemQuantity        Int                 @default(0)
  declaredWeightGrams Int                 @default(500)
  deliveryType        String?
  // Money (paisa)
  codAmountPaisa      Int                 @default(0)
  courierChargePaisa  Int                 @default(0)
  codChargePaisa      Int                 @default(0)
  deliveryFeePaisa    Int                 @default(0)
  expectedCollectionPaisa Int             @default(0)
  collectedPaisa      Int                 @default(0)
  // Lifecycle
  attemptCount        Int                 @default(0)
  requestedAt         DateTime?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  returnedAt          DateTime?
  cancelledAt         DateTime?
  lastStatusAt        DateTime?
  failureReason       String?
  providerStatusRaw   String?
  // Delivery
  deliverableQuantity Int                 @default(0)
  partialDelivery     Boolean             @default(false)
  assignedDeliveryAgent String?
  idempotencyKey      String?             @unique
  createdByUserId     String?
  metadata            Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  exchange   ExchangeRequest? @relation(fields: [exchangeRequestId], references: [id], onDelete: SetNull)
  courier    CourierProvider? @relation(fields: [courierProviderId], references: [id], onDelete: SetNull)
  statusHistory ShipmentStatusHistory[]
  charges    CourierCharge[]
  codCollection CodCollection?
  settlementEntries CourierSettlementEntry[]
  outbox     OutboxEvent[]

  @@unique([businessId, internalCode])
  @@index([orderId])
  @@index([status, createdAt])
  @@index([trackingCode])
  @@index([providerConsignmentId])
  @@index([providerCode, lastStatusAt])
}

model ShipmentStatusHistory {
  id            String         @id @default(uuid())
  shipmentId    String
  fromStatus    ShipmentStatus?
  toStatus      ShipmentStatus
  providerStatus String?
  source        ShipmentSource @default(MANUAL)
  note          String?
  actorUserId   String?
  recordedAt    DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, recordedAt])
}

model CourierCharge {
  id            String            @id @default(uuid())
  shipmentId    String
  type          CourierChargeType @default(DELIVERY)
  amountPaisa   Int
  codChargePaisa Int              @default(0)
  note          String?
  recordedByUserId String?
  createdAt     DateTime          @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, type])
}

/// Raw inbound courier webhook payloads. Provider event ids (when supplied)
/// are unique per provider so that duplicate callbacks are ignored.
model CourierWebhookEvent {
  id              String             @id @default(uuid())
  courierProviderId String?
  providerCode    CourierProviderCode
  providerEventId String?
  eventType       String
  trackingCode    String?
  signatureValid  Boolean            @default(false)
  payload         Json
  headers         Json?
  status          WebhookEventStatus @default(RECEIVED)
  processingResult String?
  errorMessage    String?
  attempts        Int                @default(1)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  ipAddress       String?

  courier CourierProvider? @relation(fields: [courierProviderId], references: [id], onDelete: SetNull)

  @@unique([providerCode, providerEventId])
  @@index([status, receivedAt])
  @@index([providerCode, receivedAt])
}

// ----------------------------------------------------------------------------
// Courier settlements
// ----------------------------------------------------------------------------

model CourierSettlement {
  id                  String            @id @default(uuid())
  businessId          String
  courierProviderId   String?
  providerCode        CourierProviderCode
  reference           String
  status              SettlementStatus  @default(DRAFT)
  periodStart         DateTime?
  periodEnd           DateTime?
  settlementDate      DateTime?
  receivedAt          DateTime?
  bankReference       String?
  grossCollectedPaisa Int               @default(0)
  courierFeePaisa     Int               @default(0)
  codChargePaisa      Int               @default(0)
  otherDeductionPaisa Int               @default(0)
  netReceivedPaisa    Int               @default(0)
  reconciledPaisa     Int               @default(0)
  unmatchedPaisa      Int               @default(0)
  note                String?
  importedByUserId    String?
  reconciledByUserId  String?
  reconciledAt        DateTime?
  idempotencyKey      String?           @unique
  sourceFileName      String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courier   CourierProvider? @relation(fields: [courierProviderId], references: [id], onDelete: SetNull)
  entries   CourierSettlementEntry[]
  codCollections CodCollection[]
  ledgerEntries ResellerLedgerEntry[]

  @@unique([businessId, providerCode, reference])
  @@index([businessId, status, settlementDate])
  @@index([providerCode, settlementDate])
}

/// A single line of a courier settlement, matched to a shipment/order.
model CourierSettlementEntry {
  id             String                @id @default(uuid())
  settlementId   String
  shipmentId     String?
  orderId        String?
  paymentId      String?
  reference      String?
  trackingCode   String?
  grossPaisa     Int                   @default(0)
  courierFeePaisa Int                  @default(0)
  codChargePaisa Int                   @default(0)
  otherDeductionPaisa Int              @default(0)
  netPaisa       Int                   @default(0)
  status         SettlementEntryStatus @default(UNMATCHED)
  matchMethod    String?
  discrepancyPaisa Int                 @default(0)
  discrepancyReason String?
  note           String?
  ledgerProcessedAt DateTime?
  matchedAt      DateTime?
  matchedByUserId String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  settlement CourierSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  shipment   Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment    Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  ledgerEntries ResellerLedgerEntry[]

  @@unique([settlementId, shipmentId])
  @@index([settlementId, status])
  @@index([orderId])
  @@index([trackingCode])
}

// ----------------------------------------------------------------------------
// Exchanges
// ----------------------------------------------------------------------------

model ExchangeRequest {
  id                String         @id @default(uuid())
  businessId        String
  exchangeNumber    String
  orderId           String
  customerId        String?
  resellerId        String?
  reasonId          String?
  reasonCode        String
  reasonNote        String?
  status            ExchangeStatus @default(REQUESTED)
  channel           ExchangeChannel @default(CUSTOMER)
  isPartial         Boolean        @default(false)
  // Money (paisa)
  returnValuePaisa    Int          @default(0)
  replacementValuePaisa Int        @default(0)
  deliveryChargePaisa Int          @default(0)
  additionalChargePaisa Int        @default(0)
  discountPaisa       Int          @default(0)
  /// Positive => customer owes the business, negative => business owes customer.
  differencePaisa     Int          @default(0)
  collectionStatus    String       @default("NONE")
  refundId            String?
  paymentId           String?
  // Lifecycle
  requestedAt         DateTime     @default(now())
  approvedAt          DateTime?
  approvedByUserId    String?
  rejectedAt          DateTime?
  rejectedByUserId    String?
  rejectionReason     String?
  receivedAt          DateTime?
  receivedByUserId    String?
  inspectedAt         DateTime?
  inspectedByUserId   String?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  replacementOrderId  String?
  replacementShipmentId String?
  returnShipmentId    String?
  expectedDeliveryAt  DateTime?
  note                String?
  internalNote        String?
  createdByUserId     String?
  updatedByUserId     String?
  idempotencyKey      String?      @unique
  metadata            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reseller     Reseller?         @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  reason       ExchangeReason?   @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  items        ExchangeItem[]
  statusHistory ExchangeStatusHistory[]
  shipments    Shipment[]
  refunds      Refund[]

  @@unique([businessId, exchangeNumber])
  @@index([orderId])
  @@index([status, createdAt])
  @@index([customerId])
}

model ExchangeItem {
  id               String            @id @default(uuid())
  exchangeRequestId String
  direction        ExchangeDirection
  orderItemId      String?
  variantId        String?
  sku              String
  productName      String
  variantName      String
  attributesSnapshot Json?
  quantity         Int
  unitPricePaisa   Int
  lineTotalPaisa   Int
  unitCostPaisa    Int               @default(0)
  inspectionOutcome InspectionOutcome @default(PENDING)
  inspectionNote   String?
  inspectedByUserId String?
  inspectedAt      DateTime?
  inspectionQuantity Int?
  restockMovementId String?
  replacementStatus String?
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  exchangeRequest ExchangeRequest @relation(fields: [exchangeRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  variant         Variant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([exchangeRequestId, direction])
  @@index([orderItemId])
}

model ExchangeStatusHistory {
  id                String         @id @default(uuid())
  exchangeRequestId String
  fromStatus        ExchangeStatus?
  toStatus          ExchangeStatus
  note              String?
  actorUserId       String?
  actorCustomerId   String?
  actorType         ActorType      @default(USER)
  createdAt         DateTime       @default(now())

  exchangeRequest ExchangeRequest @relation(fields: [exchangeRequestId], references: [id], onDelete: Cascade)

  @@index([exchangeRequestId, createdAt])
}

// =============================================================================
// Part 4: resellers & payouts, media, CMS/page builder, reviews,
//         integrations, API keys, marketing, plugins, notifications, ops
// =============================================================================

enum ResellerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ResellerCommissionType {
  MARGIN_BASED
  PERCENT_OF_MARGIN
  FIXED_PER_ORDER
  FIXED_PER_ITEM
  NONE
}

enum ResellerLedgerType {
  EARNING
  PACKAGING_CHARGE
  COURIER_CHARGE
  COD_CHARGE
  ADJUSTMENT
  REVERSAL
  PAYOUT
  PAYOUT_REVERSAL
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerEntryStatus {
  PENDING
  ELIGIBLE
  PAID
  VOID
}

enum PayoutStatus {
  DRAFT
  PENDING
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
  FAILED
}

enum PayoutMethod {
  BKASH
  BANK_TRANSFER
  CASH
  OTHER
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum PageType {
  HOME
  CONTENT
  LANDING
  POLICY
  COLLECTION
  CONTACT
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NavigationItemType {
  PAGE
  CATEGORY
  PRODUCT
  URL
  GROUP
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MarketingProvider {
  META_PIXEL
  META_CONVERSIONS
  TIKTOK_PIXEL
  GOOGLE_ANALYTICS
  CUSTOM
}

enum MarketingEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NO_CONSENT
  DISCARDED
}

enum PluginStatus {
  REGISTERED
  ENABLED
  DISABLED
  INCOMPATIBLE
  ERROR
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  DEAD
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  DEAD
}

// ----------------------------------------------------------------------------
// Resellers
// ----------------------------------------------------------------------------

model Reseller {
  id                String               @id @default(uuid())
  businessId        String
  userId            String?              @unique
  code              String
  name              String
  businessName      String?
  phone             String?
  phoneNormalized   String?
  email             String?
  status            ResellerStatus       @default(ACTIVE)
  commissionType    ResellerCommissionType @default(MARGIN_BASED)
  commissionValue   Int                  @default(0)
  /// When true, the configured reseller price already includes packaging cost.
  packagingIncluded Boolean              @default(true)
  packagingCostPaisa Int                 @default(0)
  deliveryChargePaisa Int                @default(0)
  codChargePaisa    Int                  @default(0)
  defaultDistrictCode String?
  address           String?
  nidNumber         String?
  payoutMethod      PayoutMethod         @default(BKASH)
  payoutAccountNumber String?
  payoutAccountName String?
  minimumPayoutPaisa Int                 @default(0)
  creditLimitPaisa  Int                  @default(0)
  joinedAt          DateTime             @default(now())
  suspendedAt       DateTime?
  note              String?
  createdByUserId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  priceList    PriceList?
  orders       Order[]
  ledgerEntries ResellerLedgerEntry[]
  payouts      ResellerPayout[]
  earnings     ResellerOrderEarning[]
  collectionChanges ResellerCollectionChange[]
  exchanges    ExchangeRequest[]

  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([phoneNormalized])
}

/// Immutable ledger of everything the business owes (or has paid to) a
/// reseller. Entries become ELIGIBLE only after the matching courier COD
/// settlement has been received and reconciled.
model ResellerLedgerEntry {
  id               String              @id @default(uuid())
  businessId       String
  resellerId       String
  type             ResellerLedgerType
  direction        LedgerDirection
  amountPaisa      Int
  status           LedgerEntryStatus   @default(PENDING)
  orderId          String?
  orderItemId      String?
  settlementId     String?
  settlementEntryId String?
  exchangeRequestId String?
  payoutId         String?
  description      String
  reason           String?
  eligibleAt       DateTime?
  paidAt           DateTime?
  voidedAt         DateTime?
  reversesEntryId  String?             @unique
  idempotencyKey   String?             @unique
  createdByUserId  String?
  actorType        ActorType           @default(SYSTEM)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reseller   Reseller            @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  settlement CourierSettlement?  @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  settlementEntry CourierSettlementEntry? @relation(fields: [settlementEntryId], references: [id], onDelete: SetNull)
  payout     ResellerPayout?     @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  reversesEntry ResellerLedgerEntry? @relation("LedgerReversal", fields: [reversesEntryId], references: [id], onDelete: SetNull)
  reversedBy ResellerLedgerEntry? @relation("LedgerReversal")
  payoutEntries ResellerPayoutEntry[]

  @@index([resellerId, status])
  @@index([resellerId, createdAt])
  @@index([businessId, status])
  @@index([orderId])
  @@index([type, createdAt])
}

/// Snapshot of the earnings calculation for one reseller order item.
/// Calculated from order snapshots (never from current prices).
model ResellerOrderEarning {
  id                    String   @id @default(uuid())
  businessId            String
  resellerId            String
  orderId               String
  orderItemId           String?
  collectedPaisa        Int      @default(0)
  resellerPricePaisa    Int      @default(0)
  resellerCostPaisa     Int      @default(0)
  packagingCostPaisa    Int      @default(0)
  courierChargePaisa    Int      @default(0)
  codChargePaisa        Int      @default(0)
  earningsPaisa         Int      @default(0)
  expectedCodPaisa      Int      @default(0)
  settledPaisa          Int      @default(0)
  eligibilityStatus     String   @default("PENDING")
  eligibleAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reseller  Reseller  @relation(fields: [resellerId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([orderItemId])
  @@index([resellerId, eligibilityStatus])
  @@index([orderId])
}

/// Audit trail for changes to the amount a reseller collects from their own
/// customer on a given order.
model ResellerCollectionChange {
  id            String   @id @default(uuid())
  orderId       String
  resellerId    String
  previousPaisa Int?
  newPaisa      Int
  reason        String?
  changedByUserId String?
  changedByResellerId String?
  createdAt     DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reseller Reseller @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([resellerId, createdAt])
}

model ResellerPayout {
  id              String       @id @default(uuid())
  businessId      String
  resellerId      String
  payoutNumber    String
  status          PayoutStatus @default(DRAFT)
  method          PayoutMethod @default(BKASH)
  amountPaisa     Int
  accountNumber   String?
  accountName     String?
  transactionReference String?
  periodStart     DateTime?
  periodEnd       DateTime?
  note            String?
  requestedByUserId String?
  approvedByUserId String?
  approvedAt      DateTime?
  paidByUserId    String?
  paidAt          DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  failureReason   String?
  idempotencyKey  String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business  Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reseller  Reseller              @relation(fields: [resellerId], references: [id], onDelete: Restrict)
  entries   ResellerPayoutEntry[]
  transactions ResellerPayoutTransaction[]
  ledgerEntries ResellerLedgerEntry[]

  @@unique([businessId, payoutNumber])
  @@index([resellerId, status])
  @@index([businessId, status, createdAt])
}

/// A ledger entry allocated to a payout. The unique constraint on
/// `ledgerEntryId` is the database guarantee against double payouts.
model ResellerPayoutEntry {
  id            String   @id @default(uuid())
  payoutId      String
  ledgerEntryId String   @unique
  amountPaisa   Int
  createdAt     DateTime @default(now())

  payout      ResellerPayout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  ledgerEntry ResellerLedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@index([payoutId])
}

model ResellerPayoutTransaction {
  id              String       @id @default(uuid())
  payoutId        String
  status          PayoutStatus @default(PENDING)
  providerName    String?
  providerReference String?
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  createdByUserId String?
  createdAt       DateTime     @default(now())

  payout ResellerPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId])
}

// ----------------------------------------------------------------------------
// Media
// ----------------------------------------------------------------------------

model MediaFolder {
  id          String   @id @default(uuid())
  businessId  String
  parentId    String?
  name        String
  path        String
  createdByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent   MediaFolder? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("FolderHierarchy")
  assets   MediaAsset[]

  @@unique([businessId, path])
  @@index([businessId, parentId])
}

model MediaAsset {
  id            String          @id @default(uuid())
  businessId    String
  folderId      String?
  storageProvider String        @default("S3")
  bucket        String?
  objectKey     String          @unique
  originalName  String
  mimeType      String
  extension     String
  sizeBytes     Int
  width         Int?
  height        Int?
  checksum      String?
  altText       String?
  title         String?
  caption       String?
  visibility    MediaVisibility @default(PUBLIC)
  uploadedByUserId String?
  usageCount    Int             @default(0)
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  folder    MediaFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  usages    MediaUsage[]
  productImages ProductImage[]
  variantImages VariantImage[]
  reviewImages  ReviewImage[]
  pagesAsOgImage Page[]     @relation("PageOgImage")

  @@index([businessId, createdAt])
  @@index([businessId, folderId])
  @@index([mimeType])
  @@index([businessId, deletedAt])
}

/// Where a media asset is used. Prevents deleting assets that are referenced.
model MediaUsage {
  id          String   @id @default(uuid())
  mediaId     String
  entityType  String
  entityId    String
  field       String   @default("image")
  productId   String?
  variantId   String?
  createdAt   DateTime @default(now())

  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([mediaId, entityType, entityId, field])
  @@index([entityType, entityId])
}

// ----------------------------------------------------------------------------
// Storefront content: pages, versions, navigation
// ----------------------------------------------------------------------------

model Page {
  id               String      @id @default(uuid())
  businessId       String
  storefrontId     String?
  title            String
  slug             String
  type             PageType    @default(CONTENT)
  status           PageStatus  @default(DRAFT)
  isSystem         Boolean     @default(false)
  isHomepage       Boolean     @default(false)
  publishedVersionId String?   @unique
  draftVersionId   String?     @unique
  currentVersion   Int         @default(0)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  ogMediaId        String?
  canonicalUrl     String?
  robots           String?
  template         String      @default("default")
  createdByUserId  String?
  updatedByUserId  String?
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storefront   Storefront?   @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  ogMedia      MediaAsset?   @relation("PageOgImage", fields: [ogMediaId], references: [id], onDelete: SetNull)
  versions     PageVersion[]
  navigationItems NavigationMenuItem[]

  @@unique([businessId, storefrontId, slug])
  @@index([businessId, status])
  @@index([storefrontId, status])
}

/// Immutable revision of a page. `document` holds the validated, versioned
/// page-builder document (see src/modules/page-builder).
model PageVersion {
  id            String            @id @default(uuid())
  pageId        String
  version       Int
  status        PageVersionStatus @default(DRAFT)
  document      Json
  documentVersion Int             @default(1)
  blocksCount   Int               @default(0)
  note          String?
  createdByUserId String?
  publishedByUserId String?
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId, status])
}

model NavigationMenu {
  id           String   @id @default(uuid())
  storefrontId String
  handle       String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storefront Storefront           @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  items      NavigationMenuItem[]

  @@unique([storefrontId, handle])
}

model NavigationMenuItem {
  id          String              @id @default(uuid())
  menuId      String
  parentId    String?
  label       String
  type        NavigationItemType  @default(URL)
  url         String?
  pageId      String?
  categoryId  String?
  productId   String?
  position    Int                 @default(0)
  isActive    Boolean             @default(true)
  openInNewTab Boolean            @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  menu     NavigationMenu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   NavigationMenuItem? @relation("NavHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationMenuItem[] @relation("NavHierarchy")
  page     Page?               @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([menuId, position])
}

// ----------------------------------------------------------------------------
// Reviews
// ----------------------------------------------------------------------------

model Review {
  id               String       @id @default(uuid())
  businessId       String
  storefrontId     String?
  productId        String
  variantId        String?
  customerId       String
  orderId          String?
  orderItemId      String?      @unique
  rating           Int
  title            String?
  body             String
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  isFeatured       Boolean      @default(false)
  helpfulCount     Int          @default(0)
  reportedCount    Int          @default(0)
  moderatedByUserId String?
  moderatedAt      DateTime?
  moderationNote   String?
  rejectionReason  String?
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storefront Storefront?  @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    Variant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem  OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  images     ReviewImage[]
  reports    ReviewReport[]

  @@unique([productId, customerId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([customerId])
}

model ReviewImage {
  id       String @id @default(uuid())
  reviewId String
  mediaId  String
  position Int    @default(0)
  createdAt DateTime @default(now())

  review Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  media  MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([reviewId, mediaId])
  @@index([reviewId, position])
}

model ReviewReport {
  id         String   @id @default(uuid())
  reviewId   String
  customerId String?
  reason     String
  note       String?
  status     String   @default("OPEN")
  handledByUserId String?
  handledAt  DateTime?
  createdAt  DateTime @default(now())

  review   Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@index([status, createdAt])
}

// ----------------------------------------------------------------------------
// Integrations, secrets, API keys, marketing, plugins
// ----------------------------------------------------------------------------

/// Generic integration registration (payments, storage, marketing, other).
/// Credentials live in `IntegrationSecret` encrypted with the application key.
model Integration {
  id           String          @id @default(uuid())
  businessId   String
  storefrontId String?
  kind         IntegrationKind
  provider     String
  name         String
  scopeKey     String          @default("")
  isEnabled    Boolean         @default(false)
  testMode     Boolean         @default(true)
  config       Json?
  lastCheckedAt DateTime?
  lastError    String?
  createdByUserId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storefront Storefront?        @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  secrets    IntegrationSecret[]

  @@unique([businessId, kind, provider, scopeKey])
  @@index([businessId, kind, isEnabled])
}

/// Encrypted credential storage. Values are encrypted at rest with
/// AES-256-GCM using APP_ENCRYPTION_KEY and are never returned to clients.
model IntegrationSecret {
  id            String   @id @default(uuid())
  integrationId String?
  courierProviderId String?
  key           String
  ciphertext    String
  iv            String
  authTag       String
  description   String?
  updatedByUserId String?
  lastRotatedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, key])
  @@index([courierProviderId, key])
}

model ApiKey {
  id            String       @id @default(uuid())
  businessId    String
  name          String
  /// Public lookup prefix (safe to display, e.g. "pk_live_3f9a2c").
  keyPrefix     String       @unique
  /// SHA-256 hash of the full secret. The plaintext is shown only once.
  keyHash       String
  lastFour      String?
  status        ApiKeyStatus @default(ACTIVE)
  rateLimitPerMinute Int     @default(120)
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  usageCount    Int          @default(0)
  allowedIpAddresses String[]
  description   String?
  createdByUserId String?
  revokedByUserId String?
  revokedAt     DateTime?
  revokedReason String?
  rotatedFromKeyId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scopes   ApiKeyScope[]
  logs     ApiRequestLog[]
  webhookSubscriptions WebhookSubscription[]

  @@index([businessId, status])
  @@index([keyHash])
}

model ApiKeyScope {
  id       String @id @default(uuid())
  apiKeyId String
  scope    String
  createdAt DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, scope])
}

model ApiRequestLog {
  id         String   @id @default(uuid())
  apiKeyId   String?
  method     String
  path       String
  statusCode Int
  durationMs Int
  scope      String?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  errorCode  String?
  createdAt  DateTime @default(now())

  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}

model MarketingIntegration {
  id            String            @id @default(uuid())
  businessId    String
  storefrontId  String?
  provider      MarketingProvider
  name          String
  isEnabled     Boolean           @default(false)
  consentRequired Boolean         @default(true)
  pixelId       String?
  /// Server side credentials live in IntegrationSecret (never in config).
  integrationId String?
  trackProductView Boolean        @default(true)
  trackAddToCart Boolean          @default(true)
  trackInitiateCheckout Boolean   @default(true)
  trackPurchase Boolean           @default(true)
  testEventCode String?
  config        Json?
  createdByUserId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storefront Storefront? @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  events     MarketingEvent[]

  @@unique([businessId, provider, storefrontId])
  @@index([businessId, isEnabled])
}

/// Server side conversion event with provider deduplication key and delivery
/// state. Never reports SENT unless the provider confirmed delivery.
model MarketingEvent {
  id             String               @id @default(uuid())
  businessId     String
  marketingIntegrationId String
  storefrontId   String?
  eventName      String
  /// Deterministic deduplication key sent to providers as `event_id`.
  dedupeKey      String
  customerId     String?
  orderId        String?
  sessionId      String?
  consentGranted Boolean              @default(false)
  status         MarketingEventStatus @default(PENDING)
  attempts       Int                  @default(0)
  payload        Json
  responsePayload Json?
  lastError      String?
  sentAt         DateTime?
  nextAttemptAt  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  integration  MarketingIntegration @relation(fields: [marketingIntegrationId], references: [id], onDelete: Cascade)
  storefront   Storefront?          @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([marketingIntegrationId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([orderId])
}

/// Cookie/consent state per storefront session, used to gate tracking.
model ConsentRecord {
  id           String   @id @default(uuid())
  businessId   String
  storefrontId String?
  sessionId    String
  customerId   String?
  marketingConsent Boolean @default(false)
  analyticsConsent Boolean @default(false)
  necessaryConsent Boolean @default(true)
  policyVersion String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([storefrontId, sessionId])
  @@index([businessId, createdAt])
}

/// Trusted, explicitly registered extensions. Version 1 does not execute
/// arbitrary third-party code.
model Plugin {
  id            String       @id @default(uuid())
  businessId    String
  key           String
  name          String
  version       String
  description   String?
  author        String?
  status        PluginStatus @default(REGISTERED)
  isTrusted     Boolean      @default(false)
  capabilities  String[]
  permissions   String[]
  config        Json?
  configSchema  Json?
  compatibility Json?
  installedByUserId String?
  enabledAt     DateTime?
  disabledAt    DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId, status])
}

/// Outbound webhook subscriptions for external integrations.
model WebhookSubscription {
  id            String   @id @default(uuid())
  businessId    String
  apiKeyId      String?
  name          String
  url           String
  secretHash    String
  secretCiphertext String
  secretIv      String
  secretAuthTag String
  events        String[]
  isActive      Boolean  @default(true)
  failureCount  Int      @default(0)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  createdByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  apiKey   ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([businessId, isActive])
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  subscriptionId String
  eventType      String
  payload        Json
  dedupeKey      String?
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  maxAttempts    Int                   @default(6)
  responseStatus Int?
  responseBody   String?
  lastError      String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Notifications, audit, background jobs, outbox
// ----------------------------------------------------------------------------

model Notification {
  id          String              @id @default(uuid())
  businessId  String
  type        String
  title       String
  body        String?
  severity    NotificationSeverity @default(INFO)
  entityType  String?
  entityId    String?
  url         String?
  data        Json?
  permissionKey String?
  createdByUserId String?
  createdAt   DateTime            @default(now())
  expiresAt   DateTime?

  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
}

model NotificationRecipient {
  id             String    @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  type      String
  inApp     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model AuditLog {
  id            String    @id @default(uuid())
  businessId    String?
  actorType     ActorType @default(USER)
  actorUserId   String?
  actorCustomerId String?
  actorApiKeyId String?
  actorLabel    String?
  action        String
  entityType    String
  entityId      String?
  summary       String?
  before        Json?
  after         Json?
  changedFields String[] @default([])
  reason        String?
  requestId     String?
  correlationId String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User?     @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/// Durable background job queue (processed by scripts/worker.ts).
model BackgroundJob {
  id             String    @id @default(uuid())
  businessId     String?
  queue          String    @default("default")
  type           String
  payload        Json
  status         JobStatus @default(PENDING)
  priority       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  startedAt      DateTime?
  completedAt    DateTime?
  lastError      String?
  resultSummary  String?
  idempotencyKey String?   @unique
  correlationId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status, runAt, priority])
  @@index([queue, status])
  @@index([type, createdAt])
}

/// Transactional outbox: business transactions write an event here and the
/// worker performs external side effects (courier API calls, marketing events,
/// notifications) outside of the transaction.
model OutboxEvent {
  id            String       @id @default(uuid())
  businessId    String?
  eventType     String
  aggregateType String
  aggregateId   String
  shipmentId    String?
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(8)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  lastError     String?
  dedupeKey     String?      @unique
  correlationId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType, status])
}
