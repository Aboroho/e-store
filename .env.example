# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV="development"
APP_NAME="E-Store"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# Database (PostgreSQL 15+; a shadow database is required for `prisma migrate dev`)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/estore?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/estore_shadow?schema=public"
DATABASE_POOL_SIZE="10"

# Secrets — generate with: openssl rand -base64 48
SESSION_SECRET=""
APP_ENCRYPTION_KEY=""

# Object storage: production uploads require S3-compatible, PRIVATE bucket storage.
# STORAGE_DRIVER=local is development/test only; disabled refuses uploads.
# S3_ENDPOINT must be browser reachable (not localhost for remote clients).
# See docs/MEDIA_MANAGER.md for bucket CORS, permissions, migration and cleanup.
STORAGE_DRIVER="disabled"
LOCAL_STORAGE_DIR=".cache/uploads"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_BASE_URL=""
S3_PRESIGN_EXPIRES_SECONDS="900"
MEDIA_MAX_UPLOAD_MB="15"

# Courier APIs (Bangladesh)
PATHAO_BASE_URL="https://api-hermes.pathao.com"
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"
CARRYBEE_BASE_URL="https://api.carrybee.com"

# Background worker (run `npm run worker` under systemd/supervisor)
WORKER_CONCURRENCY="5"
WORKER_POLL_MS="2000"

# Reverse proxy / cookies
# - secure cookies are enabled automatically in production; terminate TLS at the proxy
# - the app binds 0.0.0.0:3000 by default (`npm start`), put nginx/caddy in front of it

# Seed (development only)
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD=""
SEED_BUSINESS_NAME="Demo Store"
SEED_BUSINESS_PHONE="+8801700000000"
